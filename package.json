{
  "name": "lawyers-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias && cp -r src/views dist/views",
    "postinstall": "prisma generate && npm run build",
    "db:push": "prisma generate && prisma db push",
    "stripe:listener": "stripe listen --forward-to localhost:3000/api/v1/payment/webhook/stripe",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Amr Elskhawy",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google-apps/meet": "^0.7.1",
    "@google-cloud/local-auth": "^3.0.1",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "5.18.0",
    "@scalar/express-api-reference": "^0.8.44",
    "bcrypt": "^6.0.0",
    "chalk": "^5.6.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "google-auth-library": "^10.6.1",
    "google-gax": "^5.0.6",
    "googleapis": "^171.4.0",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "moment-hijri": "^3.0.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "nodemailer-express-handlebars": "^6.1.2",
    "nodemon": "^3.1.0",
    "prisma": "5.18.0",
    "puppeteer": "^23.11.1",
    "stripe": "^20.4.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "type": "module",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.1.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.9",
    "@types/nodemailer-express-handlebars": "^4.0.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.0.18",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
