generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(MODERATOR)
  isVerified  Boolean  @default(false)

  tokens      Token[]
  organizer   Organizer?

  createdCases         Case[]   @relation("CaseCreator")
  preferredOnCases     Case[]   @relation("CasePreferredLawyer")
  sessionReceivedCases Case[]   @relation("CaseSessionReceiver")
  createdSessionReports SessionReport[] @relation("SessionReportCreator")
  createdFieldVisitReports FieldVisitReport[] @relation("FieldVisitReportCreator")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Booking {
  id           String        @id @default(uuid())
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  serviceId    String
  service      Service       @relation(fields: [serviceId], references: [id])
  date         DateTime
  startTime    String
  endTime      String
  status       BookingStatus @default(PENDING)
  meetLink     String?
  calendarUrl  String?

  paymentIntentId  String?
  stripeSessionId  String?
  totalAmount      Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus    PaymentStatus @default(UNPAID)

  tabbyPaymentId   String?
  createdByRole    String?   // 'ADMIN' | 'MODERATOR' — set only for manual bookings

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model WorkingDay {
  id        String   @id @default(uuid())
  day       String   @unique
  isOpen    Boolean  @default(true)
  startTime String   @default("09:00")
  endTime   String   @default("17:00")
}

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime
  startTime String?  // Optional: "HH:mm"
  endTime   String?  // Optional: "HH:mm"
  name      String
  isFullDay Boolean  @default(false)

  @@unique([date, startTime, endTime])
}

enum Role {
  ADMIN
  MODERATOR
}

model Token {
  id                  String   @id @default(uuid())
  verificationToken   String?
  passwordResetToken  String?

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  expiresAt  DateTime
}

model Service {
  id          String   @id @default(uuid())
  name_ar        String   @default("")
  name_en        String   @default("")
  description_ar String?
  description_en String?
  price       Decimal? @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  isFree      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Booking Booking[]
}

model Customer {
  id        String   @id @default(uuid())
  fullName  String
  email     String?
  phone     String
  location  String?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseReportsFolderId String?

  bookings  Booking[]
  cases     Case[]
}

model Organizer {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CaseType {
  CRIMINAL
  ADMINISTRATIVE
  LABOR
  COMMERCIAL
  PENAL
  GENERAL
  PERSONAL_STATUS
  OTHER
}

model Case {
  id        String   @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  caseType      CaseType
  otherCaseType String?
  caseDate      DateTime
  hijriDate     String?
  agencyNumber  String?

  wantsSpecificLawyer  Boolean @default(false)
  preferredLawyerId    String?
  preferredLawyer      User?   @relation("CasePreferredLawyer", fields: [preferredLawyerId], references: [id])
  preferredLawyerName  String?

  sessionReceiverId   String?
  sessionReceiver     User?   @relation("CaseSessionReceiver", fields: [sessionReceiverId], references: [id])
  sessionReceiverName String?
  sessionDate         DateTime?

  hasStructuredNotes  Boolean  @default(true)
  weaknesses          String[] @default([])
  strengths           String[] @default([])
  gaps                String[] @default([])
  freeNotes           String?

  reportFileId      String?
  reportUrl         String?
  reportGeneratedAt DateTime?
  sentToClientAt    DateTime?

  createdById String
  createdBy   User   @relation("CaseCreator", fields: [createdById], references: [id])

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionReports    SessionReport[]
  fieldVisitReports FieldVisitReport[]

  @@index([customerId])
  @@index([createdById])
}

model SessionReport {
  id        String   @id @default(uuid())

  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  sessionDate      DateTime?
  sessionTitle     String?
  sessionSummary   String?
  courtDecision    String?
  lawyerNotes      String?
  nextSessionDate  DateTime?

  reportNumber     String?
  courtName        String?
  courtCircuit     String?
  caseCharge       String?
  opponentName     String?
  caseNumber       String?
  caseData         String?
  sessionOrdinal   String?
  attendanceOrdinal String?
  sessionTime      String?
  hijriDate        String?
  closingNote      String?

  reportFileId      String?
  reportUrl         String?
  reportGeneratedAt DateTime?
  sentToClientAt    DateTime?

  createdById String
  createdBy   User   @relation("SessionReportCreator", fields: [createdById], references: [id])

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([createdById])
}

model FieldVisitReport {
  id     String @id @default(uuid())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  reviewLawyer  String?
  reviewPlace   String?
  agencyNumber  String?
  clientName    String?
  caseNumber    String?
  reviewDate    DateTime?
  reportSummary String?

  reportFileId      String?
  reportUrl         String?
  reportGeneratedAt DateTime?
  sentToClientAt    DateTime?

  createdById String
  createdBy   User   @relation("FieldVisitReportCreator", fields: [createdById], references: [id])

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([createdById])
}

enum PaymentStatus {
  UNPAID
  PENDING
  AUTHORIZED
  PAID
  RELEASED
  REFUNDED
  FAILED
  CANCELLED
}