generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String  @id @default(uuid())
  name       String
  nameAr     String?
  nameEn     String?
  phone      String?
  location   String?
  picture    String?
  email      String  @unique
  password   String
  role       Role    @default(RECEPTIONIST)
  isVerified Boolean @default(false)

  tokens    Token[]
  organizer Organizer?

  createdCases               Case[]               @relation("CaseCreator")
  updatedCases               Case[]               @relation("CaseUpdater")
  preferredOnCases           Case[]               @relation("CasePreferredLawyer")
  consultantOnCases          Case[]               @relation("CaseConsultant")
  sessionReceivedCases       Case[]               @relation("CaseSessionReceiver")
  sourcedCases               Case[]               @relation("CaseSourceLawyer")
  tempLawyerOnCases          Case[]               @relation("CaseTempLawyer")
  tempConsultantOnCases      Case[]               @relation("CaseTempConsultant")
  recordedContractPayments   ContractPayment[]    @relation("ContractPaymentRecorder")
  createdSessionReports      SessionReport[]      @relation("SessionReportCreator")
  updatedSessionReports      SessionReport[]      @relation("SessionReportUpdater")
  createdFieldVisitReports   FieldVisitReport[]   @relation("FieldVisitReportCreator")
  updatedFieldVisitReports   FieldVisitReport[]   @relation("FieldVisitReportUpdater")
  createdLawyerFeesContracts LawyerFeesContract[] @relation("LawyerFeesContractCreator")
  updatedLawyerFeesContracts LawyerFeesContract[] @relation("LawyerFeesContractUpdater")

  createdBookings          Booking[]          @relation("BookingCreator")
  updatedBookings          Booking[]          @relation("BookingUpdater")
  createdServices          Service[]          @relation("ServiceCreator")
  updatedServices          Service[]          @relation("ServiceUpdater")
  createdConsultingRecords ConsultingRecord[] @relation("ConsultingRecordCreator")
  updatedConsultingRecords ConsultingRecord[] @relation("ConsultingRecordUpdater")
  createdCustomers         Customer[]         @relation("CustomerCreator")
  updatedCustomers         Customer[]         @relation("CustomerUpdater")
  createdHolidays          Holiday[]          @relation("HolidayCreator")
  updatedHolidays          Holiday[]          @relation("HolidayUpdater")
  createdWorkingDays       WorkingDay[]       @relation("WorkingDayCreator")
  updatedWorkingDays       WorkingDay[]       @relation("WorkingDayUpdater")
  createdOrganizers        Organizer[]        @relation("OrganizerCreator")
  updatedOrganizers        Organizer[]        @relation("OrganizerUpdater")

  activityLogs      ActivityLog[]
  createdReminders  Reminder[]    @relation("ReminderCreator")
  receivedReminders Reminder[]    @relation("ReminderRecipient")

  completedCases      Case[]           @relation("CaseCompleter")
  uploadedAttachments CaseAttachment[] @relation("AttachmentUploader")

  createdTasks  Task[]         @relation("TaskCreator")
  assignedTasks TaskAssignee[]

  createdArticles Article[] @relation("ArticleCreator")
  updatedArticles Article[] @relation("ArticleUpdater")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Booking {
  id          String        @id @default(uuid())
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id])
  date        DateTime?
  startTime   String?
  endTime     String?
  status      BookingStatus @default(PENDING)
  meetLink    String?
  calendarUrl String?

  // Installment-plan bookings carry no scheduled date/time; flagged here for future retrieval.
  isInstallmentPlan Boolean @default(false)

  paymentIntentId String?
  stripeSessionId String?
  totalAmount     Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(UNPAID)

  tabbyPaymentId String?
  tamaraOrderId  String?
  paymobOrderId  String?
  createdByRole  String? // 'ADMIN' | 'MODERATOR' — set only for manual bookings

  createdById String?
  createdBy   User?   @relation("BookingCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("BookingUpdater", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([updatedById])
}

model WorkingDay {
  id        String  @id @default(uuid())
  day       String  @unique
  isOpen    Boolean @default(true)
  startTime String  @default("09:00")
  endTime   String  @default("17:00")

  createdById String?
  createdBy   User?   @relation("WorkingDayCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("WorkingDayUpdater", fields: [updatedById], references: [id])

  @@index([createdById])
  @@index([updatedById])
}

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime
  startTime String? // Optional: "HH:mm"
  endTime   String? // Optional: "HH:mm"
  name      String
  isFullDay Boolean  @default(false)

  createdById String?
  createdBy   User?   @relation("HolidayCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("HolidayUpdater", fields: [updatedById], references: [id])

  @@unique([date, startTime, endTime])
  @@index([createdById])
  @@index([updatedById])
}

enum ReminderType {
  SESSION_DETAILS_REVIEW
  MEMO_REVIEW_UPLOAD
  URGENT_SESSION_SOON
  CUSTOM
  MEMO_REQUEST
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model Reminder {
  id     String @id @default(uuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  type    ReminderType
  title   String?
  content String?

  scheduledAt      DateTime
  repeat           Boolean  @default(false)
  repeatEveryHours Int?

  status        ReminderStatus @default(PENDING)
  lastSentAt    DateTime?
  sentCount     Int            @default(0)
  failureReason String?

  // True for the 3 reminders auto-created when a session date is set. Lets the
  // re-schedule path replace only auto reminders, leaving manual ones untouched.
  autoScheduled Boolean @default(false)

  createdById String
  createdBy   User   @relation("ReminderCreator", fields: [createdById], references: [id])

  // Set only for MEMO_REQUEST reminders — the consultant who was notified.
  recipientId String?
  recipient   User?   @relation("ReminderRecipient", fields: [recipientId], references: [id])

  // Deadline date stored on MEMO_REQUEST reminders for the consultant reminders list.
  memoDeadline DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([status, scheduledAt])
  @@index([createdById])
  @@index([recipientId])
}

enum Role {
  ADMIN
  RECEPTIONIST
  MODERATOR
  LAWYER
  CONSULTANT
}

model Token {
  id                 String  @id @default(uuid())
  verificationToken  String?
  passwordResetToken String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Service {
  id                 String   @id @default(uuid())
  name_ar            String   @default("")
  name_en            String   @default("")
  description_ar     String?
  description_en     String?
  price              Decimal? @db.Decimal(10, 2)
  isActive           Boolean  @default(true)
  isFree             Boolean  @default(false)
  isInstallmentPlans Boolean  @default(false)

  createdById String?
  createdBy   User?   @relation("ServiceCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("ServiceUpdater", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Booking Booking[]

  @@index([createdById])
  @@index([updatedById])
}

model ConsultingRecord {
  id String @id @default(uuid())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  /// Snapshot of the customer's name at the time of the record, so it stays readable even if the customer is later renamed/removed.
  clientName String

  date      DateTime
  value     Decimal  @db.Decimal(10, 2)
  type      String
  isDeleted Boolean  @default(false)

  createdById String?
  createdBy   User?   @relation("ConsultingRecordCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("ConsultingRecordUpdater", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([customerId])
  @@index([createdById])
  @@index([updatedById])
}

model Customer {
  id        String  @id @default(uuid())
  fullName  String
  email     String?
  phone     String
  location  String?
  isDeleted Boolean @default(false)

  caseReportsFolderId String?

  createdById String?
  createdBy   User?   @relation("CustomerCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("CustomerUpdater", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings            Booking[]
  cases               Case[]
  lawyerFeesContracts LawyerFeesContract[]
  consultingRecords   ConsultingRecord[]

  @@index([createdById])
  @@index([updatedById])
}

model Organizer {
  id       String  @id @default(uuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive Boolean @default(true)

  createdById String?
  createdBy   User?   @relation("OrganizerCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("OrganizerUpdater", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([updatedById])
}

enum CaseType {
  CRIMINAL
  ADMINISTRATIVE
  LABOR
  COMMERCIAL
  PENAL
  GENERAL
  PERSONAL_STATUS
  OTHER
}

enum CaseAssignmentStatus {
  UNASSIGNED
  PENDING
  ACCEPTED
  REJECTED
}

/// Litigation degree (درجة التقاضي). Each degree has a fixed UI color:
/// FIRST_INSTANCE (الابتدائية) = green, APPEAL (الاستئناف) = yellow,
/// CASSATION (النقض) = blue, PETITION (الالتماس) = orange.
enum CaseDegree {
  FIRST_INSTANCE
  APPEAL
  CASSATION
  PETITION
  OTHER
}

model Case {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  caseType        CaseType
  otherCaseType   String?
  caseDegree      CaseDegree?
  otherDegreeText String?
  caseDate        DateTime
  hijriDate       String?
  agencyNumber    String?

  // When true, the case is a real customer's case (shown in "Client Cases").
  // When false (default), it is only a "Customer Meeting" — surfaced in the
  // separate Customer Meetings list until staff flip this switch on.
  isRealCustomer Boolean @default(false)

  // Source of the client: true (default) = the client came through the company;
  // false = a lawyer brought the client to the company.
  isCompany Boolean @default(true)

  // When isCompany = false, the lawyer who brought this client to the company.
  // Pure attribution — unrelated to the assignment slots below and their
  // accept/reject lifecycles. Always null while isCompany = true.
  sourceLawyerId String?
  sourceLawyer   User?   @relation("CaseSourceLawyer", fields: [sourceLawyerId], references: [id])

  // Lawyer slot
  wantsSpecificLawyer       Boolean              @default(false)
  preferredLawyerId         String?
  preferredLawyer           User?                @relation("CasePreferredLawyer", fields: [preferredLawyerId], references: [id])
  preferredLawyerName       String?
  assignmentStatus          CaseAssignmentStatus @default(UNASSIGNED)
  assignmentRejectedAt      DateTime?
  assignmentRejectionReason String?

  // Consultant slot — independent of the lawyer slot (own accept/reject lifecycle)
  consultantId                        String?
  consultant                          User?                @relation("CaseConsultant", fields: [consultantId], references: [id])
  consultantName                      String?
  consultantAssignmentStatus          CaseAssignmentStatus @default(UNASSIGNED)
  consultantAssignmentRejectedAt      DateTime?
  consultantAssignmentRejectionReason String?

  // Stand-ins: whoever covers a slot while its holder is away. Set directly by
  // staff (no accept/reject of their own) and cleared when the slot is
  // unassigned. A stand-in sees the case and acts with the slot holder's rights.
  tempLawyerId       String?
  tempLawyer         User?   @relation("CaseTempLawyer", fields: [tempLawyerId], references: [id])
  tempLawyerName     String?
  tempConsultantId   String?
  tempConsultant     User?   @relation("CaseTempConsultant", fields: [tempConsultantId], references: [id])
  tempConsultantName String?

  sessionReceiverId   String?
  sessionReceiver     User?     @relation("CaseSessionReceiver", fields: [sessionReceiverId], references: [id])
  sessionReceiverName String?
  // Canonical session date is Hijri (sessionHijriDate + sessionTime). sessionDate is
  // the Gregorian instant derived on save — the source of truth for reminder scheduling.
  sessionHijriDate    String?
  sessionTime         String?
  sessionDate         DateTime?

  // Court (المحكمة) + case number (رقم القضية), entered from the reminders dialog.
  // Reminders are not dispatched to the client until BOTH are present.
  courtName  String?
  caseNumber String?

  hasStructuredNotes Boolean  @default(true)
  weaknesses         String[] @default([])
  strengths          String[] @default([])
  gaps               String[] @default([])
  freeNotes          String?

  reportFileId      String?
  reportUrl         String?
  reportGeneratedAt DateTime?
  sentToClientAt    DateTime?

  // Whether the case requires a consultant memo. Set via the memo-request UI.
  needsMemo    Boolean   @default(false)
  memoDeadline DateTime?
  memoType     String?

  // Set when staff mark the case "fully completed" from the reminders dialog.
  // While non-null, the case is closed: pending reminders are cancelled and new
  // reminder actions are blocked. Cleared (null) when the case is reopened.
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("CaseCompleter", fields: [completedById], references: [id])

  createdById String
  createdBy   User    @relation("CaseCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("CaseUpdater", fields: [updatedById], references: [id])

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionReports      SessionReport[]
  fieldVisitReports   FieldVisitReport[]
  lawyerFeesContracts LawyerFeesContract[]
  reminders           Reminder[]
  attachments         CaseAttachment[]
  tasks               Task[]

  @@index([customerId])
  @@index([createdById])
  @@index([updatedById])
  @@index([sourceLawyerId])
  @@index([tempLawyerId])
  @@index([tempConsultantId])
}

/// A document uploaded from a device into the customer's Drive folder and
/// surfaced in the reminders dialog. Staff can send it to the client manually
/// via WhatsApp; `sentAt` records the last successful send.
// A reusable signature image uploaded once and restamped on later documents.
// Shared app-wide (a settings-level asset, not per user); the image lives in
// the shared "signatures" Drive folder and this row holds the driveFileId.
model Signature {
  id          String @id @default(uuid())
  fileName    String
  mimeType    String
  driveFileId String

  createdAt DateTime @default(now())
}

model CaseAttachment {
  id     String @id @default(uuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  fileName    String
  mimeType    String
  sizeBytes   Int
  driveFileId String
  url         String // public link used for WhatsApp send + download

  uploadedById String
  uploadedBy   User   @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([caseId])
  @@index([uploadedById])
}

model SessionReport {
  id String @id @default(uuid())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  sessionDate     DateTime?
  sessionTitle    String?
  sessionSummary  String?
  courtDecision   String?
  lawyerNotes     String?
  nextSessionDate DateTime?

  reportNumber      String?
  courtName         String?
  courtCircuit      String?
  caseCharge        String?
  opponentName      String?
  caseNumber        String?
  caseData          String?
  sessionOrdinal    String?
  attendanceOrdinal String?
  sessionTime       String?
  hijriDate         String?
  closingNote       String?

  reportFileId      String?
  reportUrl         String?
  reportGeneratedAt DateTime?
  sentToClientAt    DateTime?

  createdById String
  createdBy   User    @relation("SessionReportCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("SessionReportUpdater", fields: [updatedById], references: [id])

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([createdById])
  @@index([updatedById])
}

model FieldVisitReport {
  id String @id @default(uuid())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  reviewLawyer  String?
  reviewPlace   String?
  agencyNumber  String?
  clientName    String?
  caseNumber    String?
  reviewDate    DateTime?
  reportSummary String?

  reportFileId      String?
  reportUrl         String?
  reportGeneratedAt DateTime?
  sentToClientAt    DateTime?

  createdById String
  createdBy   User    @relation("FieldVisitReportCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("FieldVisitReportUpdater", fields: [updatedById], references: [id])

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([createdById])
  @@index([updatedById])
}

model LawyerFeesContract {
  id String @id @default(uuid())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  contractNumber String?
  contractDay    String?
  contractDate   DateTime?
  hijriDate      String?

  clientName     String?
  clientIdNumber String?
  clientPhone    String?

  serviceDescription String?

  totalFees            Decimal? @db.Decimal(12, 2)
  firstInstallment     Decimal? @db.Decimal(12, 2)
  secondInstallment    Decimal? @db.Decimal(12, 2)
  firstInstallmentNote String?
  otherFees            String?
  currency             String?  @default("SAR")
  page2Content         String? // free-form body text below the fees table on page 2
  page3Content         String? // free-form body text on page 3 (blank-background page)

  firstPartySignature  String?
  firstPartySignedAt   DateTime?
  secondPartySignature String?
  secondPartySignedAt  DateTime?

  signingToken          String?   @unique
  signingTokenExpiresAt DateTime?
  signingUsedAt         DateTime?

  reportFileId      String?
  reportUrl         String?
  reportGeneratedAt DateTime?
  sentToClientAt    DateTime?

  createdById String
  createdBy   User    @relation("LawyerFeesContractCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("LawyerFeesContractUpdater", fields: [updatedById], references: [id])

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments ContractPayment[]

  @@index([customerId])
  @@index([caseId])
  @@index([createdById])
  @@index([updatedById])
}

/// One collection against a fees contract. The contract's `totalFees` is the
/// debt; the sum of its payments is what has been collected, and the difference
/// is what is still owed. Installment fields on the contract are unrelated to
/// this — collections are tracked as free-form amounts, not fixed schedules.
model ContractPayment {
  id String @id @default(uuid())

  contractId String
  contract   LawyerFeesContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  amount Decimal  @db.Decimal(12, 2)
  /// When the client actually paid — this is what buckets the monthly financials
  /// view, independent of when the row was created.
  paidAt DateTime
  note   String?

  recordedById String
  recordedBy   User   @relation("ContractPaymentRecorder", fields: [recordedById], references: [id])

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([paidAt])
  @@index([recordedById])
}

enum PaymentStatus {
  UNPAID
  PENDING
  AUTHORIZED
  PAID
  RELEASED
  REFUNDED
  FAILED
  CANCELLED
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

/// A staff to-do. Visibility is strictly creator + assignees — there is no
/// admin-wide view, so every read path must go through the scope filter in
/// tasks.service.ts (buildTaskScopeWhere).
model Task {
  id          String  @id @default(uuid())
  title       String
  description String?

  /// Progress notes. The only free-text field assignees may write to — the rest
  /// of the task belongs to whoever created it.
  notes String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)
  dueDate  DateTime?

  /// Opt-in, set only by an ADMIN/MODERATOR creator: lets other admins and
  /// moderators see the task for tracking purposes even when they are not
  /// assigned to it. Everyone else still needs to be the creator or an assignee.
  isVisibleForOtherAdmins Boolean @default(false)

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id])

  assignees TaskAssignee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([status])
  @@index([dueDate])
  @@index([caseId])
}

model TaskAssignee {
  id String @id @default(uuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

/// A blog article written in the dashboard by an ADMIN/MODERATOR. Read-only for
/// the public site: no comments, no likes — just the piece itself. `content`
/// holds the rich-text HTML produced by the editor (fonts, sizes, colours,
/// inline images), so it is sanitised on write and rendered as trusted HTML.
model Article {
  id      String  @id @default(uuid())
  /// URL key for the public reader page (/articles/:slug). Derived from the
  /// title on create and kept stable afterwards unless explicitly changed.
  slug    String  @unique
  title   String
  /// Short teaser shown on the article cards; falls back to the stripped
  /// opening of `content` when the writer leaves it empty.
  excerpt String?
  content String

  /// Public Drive URL of the card/hero image.
  coverImage String?

  status      ArticleStatus @default(DRAFT)
  /// Set the first time the article goes PUBLISHED; kept afterwards so the
  /// public list keeps a stable order across edits.
  publishedAt DateTime?

  createdById String?
  createdBy   User?   @relation("ArticleCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("ArticleUpdater", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([createdById])
  @@index([updatedById])
}
