generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(MODERATOR)
  isVerified  Boolean  @default(false)

  tokens      Token[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Booking {
  id           String        @id @default(uuid())
  name         String
  phone_number String
  clientEmail  String
  serviceId    String
  service      Service       @relation(fields: [serviceId], references: [id])
  date         DateTime
  startTime    String
  endTime      String
  status       BookingStatus @default(PENDING)
  meetLink     String?
  calendarUrl  String?

  paymentIntentId  String?
  stripeSessionId  String?
  totalAmount      Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus    PaymentStatus @default(UNPAID)

  tabbyPaymentId   String?
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model WorkingDay {
  id        String   @id @default(uuid())
  day       String   @unique
  isOpen    Boolean  @default(true)
  startTime String   @default("09:00")
  endTime   String   @default("17:00")
}

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime
  startTime String?  // Optional: "HH:mm"
  endTime   String?  // Optional: "HH:mm"
  name      String
  isFullDay Boolean  @default(false)

  @@unique([date, startTime, endTime])
}

enum Role {
  ADMIN
  MODERATOR
}

model Token {
  id                  String   @id @default(uuid())
  verificationToken   String?
  passwordResetToken  String?

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  expiresAt  DateTime
}

model Service {
  id          String   @id @default(uuid())
  name_ar        String   @default("")
  name_en        String   @default("")
  description_ar String?
  description_en String?
  price       Decimal? @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Booking Booking[]
}

enum PaymentStatus {
  UNPAID
  PENDING
  AUTHORIZED
  PAID
  RELEASED
  REFUNDED
  FAILED
  CANCELLED
}

enum ReportStatus {
  DRAFT
  GENERATING
  READY
  SENT
}

enum CaseType {
  CRIMINAL
  ADMINISTRATIVE
  LABOR
  COMMERCIAL
  PERSONAL_STATUS
  GENERAL
}

model SessionReport {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  status    ReportStatus @default(DRAFT)

  clientName             String
  clientPhone            String
  clientDate             DateTime
  caseType               CaseType
  specificLawyerRequested Boolean  @default(false)
  lawyerName             String?

  hasIdCopy              Boolean  @default(false)
  hasAbsherMobile        Boolean  @default(false)
  hasNationalAddress     Boolean  @default(false)
  hasDocumentsCopy       Boolean  @default(false)
  hasTawakkalna          Boolean  @default(false)

  sessionReceiverName    String?
  sessionDate            DateTime?
  strengths              String?
  weaknesses             String?
  gaps                   String?

  pdfPath                String?   // local filesystem path
  pdfUrl                 String?   // public preview URL

  sentAt                 DateTime?
  sentVia                String?   // "email" | "sms" | "whatsapp"

  // ---------- Relations ----------
  // Uncomment if you want to link reports to a user
  // createdById  String?
  // createdBy    User?   @relation(fields: [createdById], references: [id])

  @@map("session_reports")
}