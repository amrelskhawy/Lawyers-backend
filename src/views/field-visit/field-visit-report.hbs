<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8">
  <title>تقرير زيارة ميدانية - شركة سعد البقمي</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap');

    @page {
      size: 210mm 280mm;
      margin: 0;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html,
    body {
      width: 210mm;
      height: 280mm;
      direction: rtl;
      font-family: 'Cairo', 'Segoe UI', Tahoma, Arial, sans-serif;
      color: #000000;
      background: #fff;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .fv-shell {
      font-family: 'Cairo', 'Segoe UI', Tahoma, Arial, sans-serif;
      direction: rtl;
      color: #000000;
      display: flex;
      justify-content: center;
    }

    .fv-page {
      position: relative;
      width: 210mm;
      height: 280mm;
      background-image: url('{{{background_image_url}}}');
      background-size: 100% 100%;
      background-repeat: no-repeat;
      background-position: top center;
      overflow: hidden;
      container-type: inline-size;
    }

    .ov {
      position: absolute;
      color: #000000;
      font-family: 'Cairo', 'Segoe UI', Tahoma, Arial, sans-serif;
      font-weight: 700;
      line-height: 1.2;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      overflow: hidden;
      padding: 0 0.4%;
    }

    /* ============ ROW 1: review_lawyer | review_place | agency_number ============ */
    /* x:803 y:487 w:330 h:52  on 1200×1600 */
    .f-review-lawyer {
      top: 30.44%;
      left: 66.92%;
      width: 27.5%;
      height: 3.25%;
      font-size: 1.637cqw;
    }

    /* x:441 y:485 w:330 h:52 */
    .f-review-place {
      top: 30.31%;
      left: 36.75%;
      width: 27.5%;
      height: 3.25%;
      font-size: 1.637cqw;
    }

    /* x:73 y:484 w:330 h:52 */
    .f-agency-number {
      top: 30.25%;
      left: 6.08%;
      width: 27.5%;
      height: 3.25%;
      font-size: 1.637cqw;
    }

    /* ============ ROW 2: client_name | case_number | review_date ============ */
    /* x:806 y:620 w:330 h:52 */
    .f-client-name {
      top: 38.75%;
      left: 67.17%;
      width: 27.5%;
      height: 3.25%;
      font-size: 1.637cqw;
    }

    /* x:441 y:620 w:330 h:52 */
    .f-case-number {
      top: 38.75%;
      left: 36.75%;
      width: 27.5%;
      height: 3.25%;
      font-size: 1.637cqw;
    }

    /* x:73 y:620 w:330 h:52 */
    .f-review-date {
      top: 38.75%;
      left: 6.08%;
      width: 27.5%;
      height: 3.25%;
      font-size: 1.637cqw;
    }

    /* ============ SUMMARY AREA: x:16 y:793 w:1152 h:615 ============ */
    .f-report-summary {
      top: 51.56%;
      left: 1.33%;
      width: 96%;
      height: 38.44%;
      font-size: 1.637cqw;
      font-weight: 400;
      line-height: 37px;
      text-align: right;
      display: block;
      padding: 1% 1.5%;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      word-break: break-word;
      overflow: hidden;
      align-items: flex-start;
      justify-content: flex-start;
    }

    @media print {
      html,
      body {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
    }
  </style>
</head>

<body>
  <div class="fv-shell" dir="rtl">
    <div class="fv-page">
      <div class="ov f-review-lawyer">{{review_lawyer}}</div>
      <div class="ov f-review-place">{{review_place}}</div>
      <div class="ov f-agency-number">{{agency_number}}</div>

      <div class="ov f-client-name">{{client_name}}</div>
      <div class="ov f-case-number">{{case_number}}</div>
      <div class="ov f-review-date" dir="ltr">{{review_date}}</div>

      <div class="ov f-report-summary">{{report_summary}}</div>
    </div>
  </div>
</body>

</html>
