<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8">
  <title>نماذج العميل والمحامي - شركة سعد البقمي</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    /* ============================================================
       This template mirrors the Angular case-report-template 1:1.
       Positions are declared as percentages / cqw units against the
       A4 page container (210mm wide). `container-type: inline-size`
       makes cqw resolve to % of the page width, matching the
       frontend preview's behavior.
    ============================================================ */

    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap');

    @page {
      size: A4;
      margin: 0;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html,
    body {
      direction: rtl;
      font-family: 'Cairo', 'Segoe UI', Tahoma, Arial, sans-serif;
      color: #140c39;
      background: #fff;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .cf-page,
    .cf2-page {
      position: relative;
      width: 210mm;
      height: 297mm;
      page-break-after: always;
      background-size: 100% 100%;
      background-repeat: no-repeat;
      background-position: top center;
      overflow: hidden;
      container-type: inline-size;
    }

    .cf2-page:last-child {
      page-break-after: avoid;
    }

    .cf-page {
      background-image: url('{{{client_form_bg_url}}}');
    }

    .cf2-page {
      background-image: url('{{{lawyer_form_bg_url}}}');
    }

    .cf-page .ov,
    .cf2-page .ov {
      position: absolute;
      color: #000;
      font-family: 'Cairo', 'Segoe UI', Tahoma, Arial, sans-serif;
      font-weight: 500;
      line-height: 1.2;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      overflow: hidden;
    }

    .cf-page .ov[dir='ltr'],
    .cf2-page .ov[dir='ltr'] {
      unicode-bidi: bidi-override;
    }

    .cf-page .cb {
      border: 1.5px solid #140c39;
      border-radius: 2px;
      background: transparent;
    }

    .cf-page .cb.checked {
      background: #c9a84c;
      border-color: #c9a84c;
      color: #fff;
      font-weight: 800;
      font-size: 1.2cqw;
      line-height: 1;
    }

    /* ============ PAGE 1 (client form) ============ */
    .cf-name            { top: 25.25%;  left: 53.58%; width: 35.83%; height: 2.5%; font-size: 1.917cqw; }
    .cf-phone           { top: 25%;     left: 5.33%;  width: 35.83%; height: 2.5%; font-size: 1.917cqw; }
    .cf-date            { top: 30.31%;  left: 53.58%; width: 35.83%; height: 2.5%; font-size: 1.917cqw; }
    .cf-agency-number   { top: 30.19%;  left: 4.92%;  width: 35.83%; height: 2.5%; font-size: 1.917cqw; }
    .cf-other-case-type { top: 49.75%;  left: 5.5%;   width: 91.5%;  height: 2.5%; font-size: 1.917cqw; }
    .cf-lawyer-name     { top: 60.125%; left: 8.5%;   width: 72.58%; height: 2.5%; font-size: 1.917cqw; }

    .cf-ct-criminal        { top: 38.3%; left: 69.8%;  width: 2.6%; height: 1.6%; }
    .cf-ct-administrative  { top: 38.3%; left: 51.42%; width: 2.3%; height: 1.6%; }
    .cf-ct-labor           { top: 38.3%; left: 33.83%; width: 2.3%; height: 1.6%; }
    .cf-ct-commercial      { top: 38.3%; left: 10.33%; width: 2.3%; height: 1.6%; }
    .cf-ct-penal           { top: 44%;   left: 69.8%;  width: 2.6%; height: 1.8%; }
    .cf-ct-general         { top: 44%;   left: 52%;    width: 2.3%; height: 1.8%; }
    .cf-ct-personal-status { top: 44%;   left: 25%;    width: 2.3%; height: 1.8%; }
    .cf-ct-other           { top: 44%;   left: 10.33%; width: 2.3%; height: 1.8%; }

    .cf-sl-yes { top: 55.74%; left: 21.5%; width: 2.3%; height: 1.6%; }
    .cf-sl-no  { top: 55.74%; left: 10.5%; width: 2.3%; height: 1.6%; }

    /* ============ PAGE 2 (lawyer form) ============ */
    .cf2-receiver {
      top: 30.5%; left: 36%; width: 35.83%; height: 2.5%;
      font-size: 2.2cqw; font-weight: bold;
    }

    .cf2-date {
      top: 30.5%; left: 1%; width: 25%; height: 2.5%;
      font-size: 1.917cqw; font-weight: bold;
      text-align: center;
    }

    .cf2-page .cf2-notes {
      position: absolute;
      top: 34%;
      left: 5.5%;
      width: 91.5%;
      height: 55%;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: stretch;
      text-align: right;
      direction: rtl;
      padding: 0;
      font-size: 2cqw;
      color: #140c39;
      overflow: hidden;
    }

    .cf2-page .cf2-notes .nl {
      display: flex;
      align-items: center;
      gap: 0.5cqw;
      height: 5cqw;
      flex: 0 0 5.1cqw;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  </style>
</head>

<body>

  <!-- ============ PAGE 1: CLIENT FORM ============ -->
  <section class="cf-page">
    <div class="ov cf-name">{{client_name}}</div>
    <div class="ov cf-phone" dir="ltr">{{mobile_number}}</div>
    <div class="ov cf-date" dir="ltr">{{date}}</div>
    <div class="ov cf-agency-number" dir="ltr">{{agency_number}}</div>

    <div class="ov cb cf-ct-criminal {{#if ct_criminal}}checked{{/if}}">{{#if ct_criminal}}✓{{/if}}</div>
    <div class="ov cb cf-ct-administrative {{#if ct_administrative}}checked{{/if}}">{{#if ct_administrative}}✓{{/if}}</div>
    <div class="ov cb cf-ct-labor {{#if ct_labor}}checked{{/if}}">{{#if ct_labor}}✓{{/if}}</div>
    <div class="ov cb cf-ct-commercial {{#if ct_commercial}}checked{{/if}}">{{#if ct_commercial}}✓{{/if}}</div>
    <div class="ov cb cf-ct-penal {{#if ct_penal}}checked{{/if}}">{{#if ct_penal}}✓{{/if}}</div>
    <div class="ov cb cf-ct-general {{#if ct_general}}checked{{/if}}">{{#if ct_general}}✓{{/if}}</div>
    <div class="ov cb cf-ct-personal-status {{#if ct_personal_status}}checked{{/if}}">{{#if ct_personal_status}}✓{{/if}}</div>
    <div class="ov cb cf-ct-other {{#if ct_other}}checked{{/if}}">{{#if ct_other}}✓{{/if}}</div>

    {{#if ct_other}}
    <div class="ov cf-other-case-type">{{other_case_type}}</div>
    {{/if}}

    <div class="ov cb cf-sl-yes {{#if lawyer_yes}}checked{{/if}}">{{#if lawyer_yes}}✓{{/if}}</div>
    <div class="ov cb cf-sl-no {{#if lawyer_no}}checked{{/if}}">{{#if lawyer_no}}✓{{/if}}</div>

    <div class="ov cf-lawyer-name">{{preferred_lawyer_name}}</div>
  </section>

  <!-- ============ PAGE 2: LAWYER FORM ============ -->
  <section class="cf2-page">
    <div class="ov cf2-receiver">{{session_receiver}}</div>
    <div class="ov cf2-date" dir="ltr">{{session_date}}</div>

    <div class="cf2-notes">
      {{#each lines}}
      <div class="nl">{{this}}</div>
      {{/each}}
    </div>
  </section>

</body>

</html>
