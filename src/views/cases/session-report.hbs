<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8">
  <title>تقرير ما بعد الجلسة - شركة سعد البقمي</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap');

    @page { size: A4; margin: 0; }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      width: 210mm;
      height: 297mm;
      direction: rtl;
      font-family: 'Cairo', 'Segoe UI', Tahoma, Arial, sans-serif;
      color: #000;
      background: #fff;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .sr-shell {
      font-family: 'Cairo', 'Segoe UI', Tahoma, Arial, sans-serif;
      direction: rtl;
    }

    /* Page container — percentages authored against 1200×1600 canvas.
       background-size: 100% 100% ensures the image fills A4 exactly. */
    .sr-page {
      position: relative;
      width: 210mm;
      height: 297mm;
      background-image: url('{{{background_image_url}}}');
      background-size: 100% 100%;
      background-repeat: no-repeat;
      background-position: top center;
      overflow: hidden;
      container-type: inline-size;
    }

    .ov {
      position: absolute;
      color: #000000;
      font-family: 'Cairo', 'Segoe UI', Tahoma, Arial, sans-serif;
      font-weight: 700;
      line-height: 1.2;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      overflow: hidden;
      padding: 0 0.4%;
    }

    .ov[dir="ltr"] { unicode-bidi: bidi-override; }

    /* ============ TITLE STRIP ============ */
    .f-report-number  { top: 15.3%; left: 63.4%; width: 9%;    height: 2.2%; font-size: 1.448cqw; color: #ffffff; font-weight: 800; }
    .f-gregorian-date { top: 15.3%; left: 29.9%; width: 15.6%; height: 2.2%; font-size: 1.637cqw; color: #ffffff; font-weight: 800; }

    /* ============ ROW 1: إسم العميل | إسم الخصم | الدائرة ============ */
    .f-client-name    { top: 25.06%;  left: 68.17%; width: 25.17%; height: 3%; font-size: 1.667cqw; }
    .f-agent-name     { top: 25.25%;  left: 37.58%; width: 25.17%; height: 3%; font-size: 1.667cqw; }
    .f-circle         { top: 25.25%;  left: 6.5%;   width: 25.17%; height: 3%; font-size: 1.667cqw; }

    /* ============ ROW 2: جهة الاختصاص | بيانات القضية | رقم القضية ============ */
    .f-specialist-place { top: 33.38%; left: 67.92%; width: 25.17%; height: 3%; font-size: 1.667cqw; }
    .f-case-info        { top: 33.69%; left: 37.42%; width: 25.17%; height: 3%; font-size: 1.667cqw; }
    .f-case-num         { top: 33.5%;  left: 6.58%;  width: 25.17%; height: 3%; font-size: 1.667cqw; }

    /* ============ BODY: السيد/ة ============ */
    .f-customer-name {
      top: 40.06%; left: 47%; width: 36.17%; height: 3%;
      font-size: 1.667cqw;
    }

    /* ============ BODY: بتاريخ + الساعة ============ */
    .f-higri-date { top: 50.85%;  left: 39.58%; width: 16.17%; height: 3%; font-size: 2cqw; }
    .f-time       { top: 50.875%; left: 4.75%;  width: 13%;    height: 3%; font-size: 2cqw; }

    /* ============ BODY: لدى الدائرة + بمحكمة ============ */
    .f-circle-info  { top: 56.19%; left: 57.33%; width: 22.83%; height: 3%; font-size: 2.2cqw; }
    .f-circle-place { top: 56.22%; left: 25.25%; width: 20.58%; height: 3%; font-size: 2cqw; }

    /* ============ DETAILS — وتم خلال الجلسة مايلي ============ */
    .f-details {
      top: 60.75%; left: 5.42%; width: 87.17%; height: 16.75%;
      font-size: 1.667cqw;
      text-align: justify;
      display: block;
      line-height: 2.75;
      padding: 0 0.8%;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      word-break: break-word;
      overflow: hidden;
    }
    .f-details::before {
      content: '';
      float: right;
      width: 10%;
      height: calc(1.667cqw * 1.7);
    }

    /* ============ REQUIREMENTS — المتطلبات والتوجيهات القادمة ============ */
    .f-requirements {
      top: 78.375%; left: 5.42%; width: 87%; height: 11.44%;
      font-size: 1.667cqw;
      text-align: justify;
      display: block;
      line-height: 2.75;
      padding: 0 0.8%;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      word-break: break-word;
      overflow: hidden;
    }
    .f-requirements::before {
      content: '';
      float: right;
      width: 37%;
      height: calc(1.667cqw * 1.7);
    }

    @media print {
      html, body { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
    }
  </style>
</head>

<body>
  <div class="sr-shell" dir="rtl">
    <div class="sr-page">

      <!-- Title strip -->
      <div class="ov f-report-number">{{report_number}}</div>
      <div class="ov f-gregorian-date" dir="ltr">{{gregorian_date}}</div>

      <!-- Row 1 -->
      <div class="ov f-client-name">{{customer_name}}</div>
      <div class="ov f-agent-name">{{opponent_name}}</div>
      <div class="ov f-circle">{{court_circuit}}</div>

      <!-- Row 2 -->
      <div class="ov f-specialist-place">{{court_name}}</div>
      <div class="ov f-case-info">{{case_data}}</div>
      <div class="ov f-case-num" dir="ltr">{{case_number}}</div>

      <!-- Body: السيد/ة -->
      <div class="ov f-customer-name">{{customer_name}}</div>

      <!-- Body: date + time -->
      <div class="ov f-higri-date" dir="ltr">{{hijri_date}}</div>
      <div class="ov f-time" dir="ltr">{{session_time}}</div>

      <!-- Body: لدى الدائرة + بمحكمة -->
      <div class="ov f-circle-info">{{case_charge}}</div>
      <div class="ov f-circle-place">{{session_ordinal}}</div>

      <!-- Session details -->
      <div class="ov f-details">{{session_summary}}</div>

      <!-- Requirements -->
      <div class="ov f-requirements">{{closing_note}}</div>

    </div>
  </div>
</body>

</html>
