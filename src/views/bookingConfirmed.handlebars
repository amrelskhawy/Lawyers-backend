<!DOCTYPE html>
<html>

<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 600px;
            margin: 30px auto;
            background: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .header {
            background-color: #28a745;
            padding: 30px 20px;
            text-align: center;
            color: #ffffff;
        }

        .header h1 {
            margin: 0;
            font-size: 22px;
        }

        .header .checkmark {
            font-size: 40px;
            margin-bottom: 8px;
        }

        .content {
            padding: 30px 24px;
            color: #333333;
            line-height: 1.6;
        }

        .details-box {
            background-color: #f8f9fa;
            border-left: 4px solid #28a745;
            border-radius: 4px;
            padding: 16px 20px;
            margin: 20px 0;
        }

        .details-box p {
            margin: 6px 0;
        }

        .button {
            display: inline-block;
            padding: 12px 24px;
            background-color: #28a745;
            color: #ffffff !important;
            text-decoration: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: bold;
            margin: 4px;
        }

        .button-secondary {
            background-color: #6c757d;
        }

        .footer {
            text-align: center;
            font-size: 12px;
            color: #6c757d;
            padding: 16px 20px;
            border-top: 1px solid #e9ecef;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <h1>Booking Confirmed!</h1>
        </div>
        <div class="content">
            <p>Hello <strong>{{name}}</strong>,</p>
            <p>Great news! Your booking has been confirmed and your payment has been processed successfully.</p>

            <div class="details-box">
                <p><strong>Service:</strong> {{service_name}}</p>
                <p><strong>Date:</strong> {{date}}</p>
                <p><strong>Time:</strong> {{start_time}} – {{end_time}}</p>
                <p><strong>Total Paid:</strong> {{total_amount}} SAR</p>
                <p><strong>Payment Provider:</strong> {{provider}}</p>
            </div>

            {{#if meet_link}}
            <p style="text-align:center;">
                <a href="{{meet_link}}" class="button">Join Google Meet</a>
            </p>
            {{/if}}

            {{#if calendar_url}}
            <p style="text-align:center;">
                <a href="{{calendar_url}}" class="button button-secondary">Add to Calendar</a>
            </p>
            {{/if}}

            {{#if provider}}
            {{#if (eq provider "STRIPE")}}
            <p style="font-size:13px; color:#666;">A payment receipt PDF is attached to this email for your records.</p>
            {{/if}}
            {{/if}}

            <p>We look forward to seeing you. If you have any questions, please don't hesitate to contact us.</p>
        </div>
        <div class="footer">
            <p>Thank you for choosing our service.</p>
        </div>
    </div>
</body>

</html>