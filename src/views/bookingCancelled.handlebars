<!DOCTYPE html>
<html>

<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 600px;
            margin: 30px auto;
            background: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .header {
            background-color: #dc3545;
            padding: 30px 20px;
            text-align: center;
            color: #ffffff;
        }

        .header h1 {
            margin: 0;
            font-size: 22px;
        }

        .content {
            padding: 30px 24px;
            color: #333333;
            line-height: 1.6;
        }

        .details-box {
            background-color: #f8f9fa;
            border-left: 4px solid #dc3545;
            border-radius: 4px;
            padding: 16px 20px;
            margin: 20px 0;
        }

        .details-box p {
            margin: 6px 0;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .status-released {
            background-color: #fff3cd;
            color: #856404;
        }

        .status-refunded {
            background-color: #d4edda;
            color: #155724;
        }

        .status-cancelled {
            background-color: #f8d7da;
            color: #721c24;
        }

        .refund-notice {
            background-color: #d4edda;
            border: 1px solid #c3e6cb;
            border-radius: 4px;
            padding: 12px 16px;
            margin: 16px 0;
            font-size: 14px;
            color: #155724;
        }

        .no-charge-notice {
            background-color: #fff3cd;
            border: 1px solid #ffc107;
            border-radius: 4px;
            padding: 12px 16px;
            margin: 16px 0;
            font-size: 14px;
            color: #856404;
        }

        .footer {
            text-align: center;
            font-size: 12px;
            color: #6c757d;
            padding: 16px 20px;
            border-top: 1px solid #e9ecef;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <h1>Booking Cancelled</h1>
        </div>
        <div class="content">
            <p>Hello <strong>{{name}}</strong>,</p>
            <p>Your booking has been cancelled. Here are the details of the cancelled appointment:</p>

            <div class="details-box">
                <p><strong>Service:</strong> {{service_name}}</p>
                <p><strong>Date:</strong> {{date}}</p>
                <p><strong>Time:</strong> {{start_time}} – {{end_time}}</p>
                <p><strong>Amount:</strong> {{total_amount}} SAR</p>
                <p><strong>Payment Provider:</strong> {{provider}}</p>
            </div>

            {{#if (eq payment_status "refunded")}}
            <div class="refund-notice">
                💚 <strong>Refund Issued:</strong> Your payment of {{total_amount}} SAR has been refunded. Please allow
                5–10 business days for the funds to appear in your account. A refund receipt is attached to this email.
            </div>
            {{else if (eq payment_status "released")}}
            <div class="no-charge-notice">
                ✅ <strong>No Charge:</strong> Your payment authorisation has been released. You have not been charged.
                The amount was temporarily held by your bank, it will be automatically released, and the funds will
                be available in your account within 7 days, depending on your bank's processing time.
            </div>
            {{else}}
            <div class="no-charge-notice">
                ℹ️ Your booking has been cancelled. No charge was applied.
            </div>
            {{/if}}

            <p>If you have any questions about this cancellation, please contact our support team.</p>
        </div>
        <div class="footer">
            <p>Thank you for choosing our service. We hope to serve you again.</p>
        </div>
    </div>
</body>

</html>